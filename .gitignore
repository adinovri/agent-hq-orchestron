node_modules/
.next/
# Alternate Next.js dist dirs (NEXT_DIST_DIR) — the E2E environment builds
# the same tree into .next-e2e so its `next start` and the deployed one do
# not share output.
.next-*/
dist/
.env
.env.local
*.log
*.bak
.DS_Store
coverage/
.cache/

# Serwist service-worker build artifact — regenerated on every web build,
# would create noisy diffs.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# Session-scoped working notes + sub-agent task prompts (audit reports,
# handoff summaries, batch implementation scripts). Not production docs.
scratchpad/
scripts/*.md
# ...but scripts/README.md documents the checked-in scripts and IS a doc.
!scripts/README.md
*.tsbuildinfo
